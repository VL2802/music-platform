@page
@using ML_WebApp.MDA
@model ML_WebApp.Pages.ArtistPageModel
@{
}

<div class="placement-artist-form">
    <aside class="sidebar navbar-dark bg-dark">
        @* <h2>Statistics</h2> *@
        <button class="create" onclick="openMediaModal()">Create New Media</button>
        <button class="create" onclick="openCollectionModal()">Create New Collection</button>
    </aside>

    <div class="main-content-items">
        <div class="search-bar">
            <input type="text" placeholder="Search items" class="field-input" id="itemsSearchInput" onkeyup="filterItems()" />
        </div>
        <div class="item-type">
            <span class="text-danger"></span>
            <select name="Type" id="typeSelector" class="form-control" onchange="toggleItemList()">
                <option value="Media">Media</option>
                <option value="Collection">Collection</option>
            </select>
        </div>
        @if (!string.IsNullOrEmpty(Model.ActionLogger as string))
        {
            <div class="alert alert-danger">
                @Model.ActionLogger
            </div>
        }
        <section id="mediaList" class="media-list  navbar-dark bg-dark ">
            @foreach (var media in Model.ArtistMedia)
            {
                <div class="media-item">
                    <span>@media.GetTitle()</span>
                    <div class="actions">
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <form method="post" asp-page-handler="EditMedia">
                                <input type="hidden" name="id" value="@media.GetIdDB()" />
                                <button type="submit">Edit</button>
                            </form>
                            <button class="delete" onclick="confirmDelete('@media.GetIdUI()')">
                                Delete
                            </button>
                        </div>
                    </div>
                    <div class="navbar-dark bg-dark">
                        <audio controls>
                            <source src="@media.GetFilePath()" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    </div>

                </div>
            }
        </section>

        <section id="collectionList" class="media-list navbar-dark bg-dark" style="display:none;">
            @foreach (var collection in Model.ArtistCollections)
            {
                <div class="media-item">
                    <span>@collection.Item1.GetTitle()</span>
                    <div class="actions">
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <form method="post" asp-page-handler="EditCollection">
                                <input type="hidden" name="id" value="@collection.Item1.GetIdDB()" />
                                <button type="submit">Edit</button>
                            </form>
                            <button class="delete" onclick="confirmDelete('@collection.Item1.GetIdUI()')">
                                Delete
                            </button>
                        </div>
                       
                    </div>
                </div>
            }
        </section>
    </div>
</div>

<div id="confirmDeleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <div class="centered-container">
            <p class="align-content-center">Are you sure you want to delete this item?</p>
        </div>
        <div class="modal-actions">
            <form method="post" asp-page-handler="Delete">
                <button type="button" class="play-button" onclick="closeDeleteModal()">Back</button>
                <input type="hidden" name="DeleteItemId" id="deleteItemId" />
                <button type="submit" name="action" value="logout" class="play-button align-content-center">Delete</button>
            </form>
        </div>
    </div>
</div>

<div id="mediaModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <h2>Media Content</h2>
        <form method="post" asp-page-handler="SaveMedia" enctype="multipart/form-data">
            <input asp-for="EditableMedia.MediaId" type="hidden" />
            <div class="media-form">
                
                <div class="image-section">
                    <div id="previewContainerMedia">
                        @if (Model.EditableMedia?.FileImage != null)
                        {
                            <img id="previewImageMedia"
                                 src="@Url.Content("~/Media/" + Model.EditableMedia.FileImage.FileName)"
                                 alt="Uploaded Image"
                                 style="max-width:150px; max-height:150px; border-radius:10px;" />
                        }
                        else
                        {
                            <div class="musicIcon justify-content-center"></div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditableMedia.FileImage" class="form-label">Upload an image</label>
                        <input asp-for="EditableMedia.FileImage" class="form-control" type="file" id="ImageFileInputMedia" onchange="updateImageFilePreviewMedia()" />
                        <span asp-validation-for="EditableMedia.FileImage"></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ActionLogger as string))
                    {
                        <div class="alert alert-danger">
                            @Model.ActionLogger
                        </div>
                        
                    }
                </div>

                <div class="form-fields">
                   @*  <select id="mediaType" asp-for="EditableMedia.MediaType" asp-items="Html.GetEnumSelectList<SharedLibraryML.MediaType>()" class="field-input-reg-log" onchange="handleMediaTypeChange()">
                    </select> *@
                     @if (Model.EditableMedia?.MediaId > 0)
                    {
                    <select hidden id="mediaType" asp-for="EditableMedia.MediaType" asp-items="Html.GetEnumSelectList<SharedLibraryML.MediaType>()" class="field-input-reg-log" onchange="handleMediaTypeChange()">
                    </select>
                    <input value="@Model.EditableMedia.MediaType.ToString()" class="field-input-reg-log" readonly />
                    }
                    else
                    {
                    <select id="mediaType" asp-for="EditableMedia.MediaType"
                    asp-items="Html.GetEnumSelectList<SharedLibraryML.MediaType>()"
                    class="field-input-reg-log"
                    onchange="handleMediaTypeChange()">
                    <option value="0" selected>Song</option>
                    </select>
                    }
                    <span asp-validation-for="EditableMedia.MediaTitle" class="text-danger"></span>
                    <input asp-for="EditableMedia.MediaTitle" type="text" class="field-input" placeholder="Title" />

                    <div id="lyricsGroup" style="display: none;">
                        <span asp-validation-for="EditableMedia.Lyrics" class="text-danger"></span>
                        <input asp-for="EditableMedia.Lyrics" type="text" class="field-input" placeholder="Lyrics" />
                    </div>

                    <div id="genreGroup">
                        <div id="musicGenreContainer">
                            <span asp-validation-for="EditableMedia.MusicGenre" class="text-danger"></span>
                            <select asp-for="EditableMedia.MusicGenre" asp-items="Html.GetEnumSelectList<SharedLibraryML.MainMusicGenre>()" class="field-input-reg-log" placeholder="Select Genre" id="musicGenreDropdown" style="display: none;">
                            </select>
                        </div>

                        <div id="bookGenreContainer">
                            <select asp-for="EditableMedia.BookGenre" asp-items="Html.GetEnumSelectList<SharedLibraryML.BookGenre>()" class="field-input-reg-log" id="bookGenreDropdown" placeholder="Select Genre" style="display: none;">
                            </select>
                        </div>
                    </div>

                    <div id="subgenreGroup" style="display: none;">
                        <span asp-validation-for="EditableMedia.SubGenre" class="text-danger"></span>
                        <input asp-for="EditableMedia.SubGenre" type="text" class="field-input" placeholder="SubGenre" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditableMedia.FileAudio" class="form-label">Upload an audio</label>
                        <input asp-for="EditableMedia.FileAudio" class="form-control" type="file" id="AudioFileInputMedia" />
                        <span asp-validation-for="EditableMedia.FileAudio"></span>
                    </div>
                    <span asp-validation-for="EditableMedia.Published" class="text-danger"></span>
                    <input asp-for="EditableMedia.Published" type="date" class="field-input" placeholder="Published Date" />
                </div>
            </div>
           
            <div class="modal-actions">
                <button type="button" class="cancel-btn" onclick="closeMediaModal()">Back</button>
                <button type="submit" class="save-btn">Save</button>
                <button type="submit" asp-page-handler="ResetForm" style="display: none;" id="hiddenResetButton"></button>

            </div>
        </form>
    </div>
</div>

<div id="collectionModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <h2>Collection Content</h2>
        <form method="post" asp-page-handler="SaveCollection" enctype="multipart/form-data">
            <input asp-for="EditableCollection.CollectionId" type="hidden" />

            <div class="collection-form">
                <div class="image-section">
                    <div id="previewContainerCollection">
                        @if (Model.EditableCollection?.FileImage != null)
                        {
                            <img id="previewImageCollection"
                                 src="@Url.Content("~/Media/" + Model.EditableCollection.FileImage.FileName)"
                                 alt="Uploaded Image"
                                 style="max-width:150px; max-height:150px; border-radius:10px;" />
                        }
                        else
                        {
                            <div class="musicIcon justify-content-center"></div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditableCollection.FileImage" class="form-label">Upload an image</label>
                        <input asp-for="EditableCollection.FileImage" class="form-control" type="file" id="fileInputCollection" onchange="updateFilePreviewCollection()" />
                        <span asp-validation-for="EditableCollection.FileImage"></span>
                    </div>
                </div>


                <div class="form-fields">
                    <span asp-validation-for="EditableCollection.CollectionTitle" class="text-danger"></span>
                    <input asp-for="EditableCollection.CollectionTitle" type="text" class="field-input" placeholder="Title" />
                    <span asp-validation-for="EditableCollection.Type" class="text-danger"></span></br>
                    <select asp-for="EditableCollection.Type"
                            asp-items="Html.GetEnumSelectList<SharedLibraryML.ArtistCollectionType>()"
                            class="field-input">
                    </select>
                       <select id="mediaSelect" class = "field-input">
                            <option>Select a media</option>
                            @foreach (var media in Model.ArtistMedia)
                            {
                                if(media is SharedLibraryML.MediaSection.Song)
                                {
                                    <option value="@media.GetIdDB()">Song: @media.GetTitle()</option>

                                }
                                else if (media is SharedLibraryML.MediaSection.Chapter)
                                {
                                    <option value="@media.GetIdDB()">Chapter: @media.GetTitle()</option>

                                }
                            }
                       </select> 
                      
                    <section id="selectedMediaList" class="media-list-in-collection-form navbar-dark bg-dark">
                        <div id="hiddenMediaInputs">
                            @if (Model.EditableCollection?.MediaIds != null)
                            {
                                foreach (var mediaId in Model.EditableCollection.MediaIds)
                                {
                                    var media = Model.ArtistMedia.FirstOrDefault(m => m.GetIdDB() == mediaId);
                                    if (media != null)
                                    {
                                        <div class="media-item-in-collection-form">
                                            <span>@media.GetTitle()</span>
                                            <div class="actions">
                                                <button type="button" onclick="removeMedia('@media.GetIdDB()', this)">Delete</button>
                                            </div>
                                            <input type="hidden" name="EditableCollection.MediaIds" value="@media.GetIdDB()" />
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </section>

                    <button type="button" class="upload-btn" onclick="addMedia()">Add</button> 
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ViewData["ActionLogger"] as string))
            {
                <div class="alert alert-danger">
                    @ViewData["ActionLogger"]
                </div>
            }
            <div class="modal-actions">
                <button type="button" class="cancel-btn" onclick="closeCollectionModal()">Back</button>
                <button type="submit" class="save-btn">Save</button>
                <button type="submit" asp-page-handler="ResetForm" style="display: none;" id="hiddenResetButton"></button>

            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var showMediaModal = '@Model.ShowMediaModal'.toLowerCase() === 'true';
        if (showMediaModal) {
            openMediaModal();
        }
        var showCollectionModal = '@Model.ShowCollectionModal'.toLowerCase() === 'true';
        if (showCollectionModal) {
            openCollectionModal();
        }

        handleMediaTypeChange();
        toggleItemList();

    });

   

    function openMediaModal() {
        console.log("Opening media modal");
        document.getElementById("mediaModal").style.display = "flex";
    }

    function closeMediaModal() {
        console.log("Closing media modal");

        document.getElementById("mediaModal").style.display = "none";

        const validationErrors = document.querySelectorAll("#mediaModal .field-validation-error, #mediaModal .text-danger");
        validationErrors.forEach(el => {
            el.textContent = "";
            el.classList.remove("field-validation-error");
            el.classList.add("field-validation-valid");
        });

        const form = document.querySelector("#mediaModal form");
        if (form) {
            form.reset();

            const fileInputs = form.querySelectorAll('input[type="file"]');
            fileInputs.forEach(input => {
                input.value = "";
            });

            const customInputs = form.querySelectorAll("input[type='text'], textarea, select");
            customInputs.forEach(input => {
                input.value = "";
            });
        }

        const previewContainer = document.getElementById("previewContainerMedia");
        if (previewContainer) {
            previewContainer.innerHTML = '<div class="musicIcon justify-content-center"></div>';
        }

        const errorToast = document.getElementById("mediaErrorToast");
        if (errorToast) {
            errorToast.style.display = "none";
        }
        document.getElementById('hiddenResetButton').click();

    }


    function openCollectionModal() {
        document.getElementById("collectionModal").style.display = "flex";

        // const hiddenInputs = document.querySelectorAll('input[name="EditableCollection.MediaIds"]');
        // hiddenInputs.forEach(input => selectedMedia.add(input.value));
    }

    function closeCollectionModal() {
        document.getElementById("collectionModal").style.display = "none";

        const form = document.querySelector("#collectionModal form");
        if (form) {
            form.reset();

            const fileInput = form.querySelector('input[type="file"]');
            if (fileInput) {
                fileInput.value = "";
            }
        }

        const mediaSelect = document.getElementById("mediaSelect");
        if (mediaSelect) {
            mediaSelect.selectedIndex = 0;
        }

        const typeSelect = form.querySelector('select[name="EditableCollection.Type"]');
        if (typeSelect) {
            typeSelect.selectedIndex = 0;
        }

        const validationErrors = form.querySelectorAll(".field-validation-error, .text-danger");
        validationErrors.forEach(el => {
            el.textContent = "";
            el.classList.remove("field-validation-error");
            el.classList.add("field-validation-valid");
        });

        selectedMedia.clear();

        document.getElementById("selectedMediaList").innerHTML = "";
        document.getElementById("hiddenMediaInputs").innerHTML = "";

        const previewContainer = document.getElementById("previewContainerCollection");
        if (previewContainer) {
            previewContainer.innerHTML = '<div class="musicIcon justify-content-center"></div>';
        }
        document.getElementById('hiddenResetButton').click();

    }



    function updateImageFilePreviewMedia() {
        const input = document.getElementById('ImageFileInputMedia');
        const container = document.getElementById('previewContainerMedia');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                container.innerHTML = `<img id="previewImageMedia" src="${e.target.result}"
                            alt="Preview Image" style="max-width:150px; max-height:150px; border-radius:10px;" />`;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

   

    function updateFilePreviewCollection() {
        const input = document.getElementById('fileInputCollection');
        const container = document.getElementById('previewContainerCollection');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                container.innerHTML = `<img id="previewImageCollection" src="${e.target.result}"
                                alt="Preview Image" style="max-width:150px; max-height:150px; border-radius:10px;" />`;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function handleMediaTypeChange() {
        const mediaType = parseInt(document.getElementById("mediaType").value, 10);

        const lyricsGroup = document.getElementById("lyricsGroup");
        const subgenreGroup = document.getElementById("subgenreGroup");

        const musicGenreDropdown = document.getElementById("musicGenreDropdown");
        const bookGenreDropdown = document.getElementById("bookGenreDropdown");

        if (mediaType === 0) {
            lyricsGroup.style.display = "block";
            subgenreGroup.style.display = "block";

            musicGenreDropdown.style.display = "block";
            bookGenreDropdown.style.display = "none";
        } else if (mediaType === 1 ) {
            lyricsGroup.style.display = "none";
            subgenreGroup.style.display = "none";

            musicGenreDropdown.style.display = "none";
            bookGenreDropdown.style.display = "block";
        }
    }


    function toggleItemList() {
        var selectedType = document.getElementById("typeSelector").value;
        var mediaList = document.getElementById("mediaList");
        var collectionList = document.getElementById("collectionList");

        if (selectedType === "Media") {
            mediaList.style.display = "block";
            collectionList.style.display = "none";
        } else {
            mediaList.style.display = "none";
            collectionList.style.display = "block";
        }
    }

    function confirmDelete(itemId) {
        document.getElementById("deleteItemId").value = itemId;
        document.getElementById("confirmDeleteModal").style.display = "flex";
    }
    

    function closeDeleteModal() {
        document.getElementById("confirmDeleteModal").style.display = "none";
    }

    const selectedMedia = new Set();

    function addMedia() {
        const select = document.getElementById("mediaSelect");
        const selectedId = select.value;
        const selectedText = select.options[select.selectedIndex].text;

        if (!selectedId || selectedMedia.has(selectedId)) return

        selectedMedia.add(selectedId);

        const list = document.getElementById("selectedMediaList");
        const div = document.createElement("div");
        div.className = "media-item-in-collection-form";
        div.innerHTML = `
                <span>${selectedText}</span>
                <div class="actions">
                    <button type="button" onclick="removeMedia('${selectedId}', this)">Delete</button>
                </div>
            `;
        list.appendChild(div);

        updateHiddenInput();


    }

    function removeMedia(id, button) {
        selectedMedia.delete(id);
        button.closest('.media-item-in-collection-form').remove();
        updateHiddenInput();
    }

    function updateHiddenInput() {
        const container = document.getElementById("hiddenMediaInputs");
        container.innerHTML = ''; 

        Array.from(selectedMedia).forEach((id, index) => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = `EditableCollection.MediaIds`;
            input.value = id;
            container.appendChild(input);
        });
    }

    function filterItems() {
        const input = document.getElementById("itemsSearchInput").value.toLowerCase();

        const mediaList = document.getElementById("mediaList");
        const collectionList = document.getElementById("collectionList");

        let items = [];

        if (mediaList.style.display !== "none") {
            items = mediaList.querySelectorAll(".media-item");
        } else if (collectionList.style.display !== "none") {
            items = collectionList.querySelectorAll(".media-item");
        }

        items.forEach(item => {
            const title = item.querySelector("span")?.textContent.toLowerCase() || "";
            item.style.display = title.includes(input) ? "" : "none";
        });
    }


</script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}