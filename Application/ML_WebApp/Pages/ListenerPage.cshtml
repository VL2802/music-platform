@page
@model ML_WebApp.Pages.ListenerPageModel
@{
}
<h2>Your Playlists</h2>
<div class="placement-artist-form">
    <aside class="sidebar navbar-dark bg-dark">
        <div class="sidebar navbar-dark bg-dark">
            <button class="create" onclick="openPlaylistModal()">Create New Playlist</button>

        </div>
        <div class="sidebar navbar-dark bg-dark">
            <section>
                <h5>Player @((Model.SelectedPlaylist != null) ? $"{Model.SelectedPlaylist.GetTitle()}" : "")</h5>


                @if (Model.SelectedPlaylist != null && Model.SelectedMediaItems != null)
                {
                    <ul>
                        @foreach (var media in Model.SelectedMediaItems)
                        {
                            <div styles="display: inline-block, gap:10px">
                                @media.GetTitle()
                                <audio controls>
                                    <source src="@media.GetFilePath()" type="audio/mpeg">
                                    Your browser does not support the audio element.
                                </audio>
                            </div>
                        }
                    </ul>
                }
                else
                {
                    <p>Select a playlist to view its media.</p>
                }
            </section>
        </div>
       
    </aside>

    <div class="main-content-items">
        <div class="search-bar">
            <input type="text" placeholder="Search playlists" class="field-input" id="playlistSearchInput" onkeyup="filterPlaylists()" />
        </div>
        @if (!string.IsNullOrEmpty(Model.ActionLogger as string))
        {
            <div class="alert alert-danger">
                @Model.ActionLogger
            </div>
        }

        <section id="playlistList" class="media-list navbar-dark bg-dark">
            @foreach (var playlist in Model.ListenerPlaylists)
            {
                <div class="media-item">
                    <span>@playlist.Item1.GetTitle()</span>
                        <div class="actions">
                            <form method="post" asp-page-handler="EditCollection">
                                <input type="hidden" name="id" value="@playlist.Item1.GetIdDB()" />
                                <button type="submit">Edit</button>
                            </form>
                            <form method="post" asp-page-handler="ViewPlaylist">
                                <input type="hidden" name="id" value="@playlist.Item1.GetIdDB()" />
                                <button type="submit">View</button>
                            </form>
                            <button class="delete" onclick="confirmDelete(@playlist.Item1.GetIdDB())">Delete</button>
                        </div>                   
                </div>
            }
        </section>
    </div>
</div>

<div id="confirmDeleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <p>Are you sure you want to delete this playlist?</p>
        <form method="post" asp-page-handler="Delete">
            <button type="button" class="play-button" onclick="closeDeleteModal()">Back</button>
            <input type="hidden" name="DeleteItemId" id="deleteItemId" />
            <button type="submit" class="play-button align-content-center">Delete</button>
        </form>
    </div>
</div>

<div id="playlistModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <h2>Playlist</h2>
        <form method="post" asp-page-handler="SavePlaylist" enctype="multipart/form-data">
            <input asp-for="EditablePlaylist.CollectionId" type="hidden" />
            <div class="media-form">
                <div class="image-section">
                    <div id="previewContainer">
                        @if (Model.EditablePlaylist?.FileImage != null)
                        {
                            <img id="previewImage"
                                 src="@Url.Content("~/Media/" + Model.EditablePlaylist.FileImage.FileName)"
                                 alt="Uploaded Image"
                                 style="max-width:150px; max-height:150px; border-radius:10px;" />
                        }
                        else
                        {
                            <div id="musicIcon" class="musicIcon justify-content-center"></div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="EditablePlaylist.FileImage" class="form-label">Upload an image</label>
                        <input asp-for="EditablePlaylist.FileImage" class="form-control" type="file" id="fileInput" onchange="updateFilePreview()" />
                        <span asp-validation-for="EditablePlaylist.FileImage"></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ActionLogger as string))
                    {
                        <div class="alert alert-danger">
                            @Model.ActionLogger
                        </div>
                    }
                </div>
                <div class="form-fields">
                    <span asp-validation-for="EditablePlaylist.CollectionTitle" class="text-danger"></span>
                    <input asp-for="EditablePlaylist.CollectionTitle" class="field-input" placeholder="Title" />

                    <span asp-validation-for="EditablePlaylist.Description" class="text-danger"></span>
                    <input asp-for="EditablePlaylist.Description" class="field-input" placeholder="Description" />

                <select asp-for="EditablePlaylist.Privacy" class="field-input-reg-log">
                    <option value="">Select a privacy</option>
                    <option value="0">Private</option>
                    <option value="1">Public</option>
                </select>

                    <select id="mediaSelect" class="field-input">
                        <option>Select a media</option>
                        @foreach (var media in Model.AllMedia)
                        {
                            <option value="@media.Item1.GetIdDB()">@media.Item1.GetTitle()</option>
                        }
                    </select>

                    <section id="selectedMediaList" class="media-list-in-collection-form navbar-dark bg-dark">
                        <div id="hiddenMediaInputs">
                            @if (Model.EditablePlaylist?.MediaIds != null)
                            {
                                foreach (var mediaId in Model.EditablePlaylist.MediaIds)
                                {
                                    var media = Model.AllMedia.FirstOrDefault(m => m.Item1.GetIdDB() == mediaId);
                                    if (media.Item1 != null)
                                    {
                                        <div class="media-item-in-collection-form">
                                            <span>@media.Item1.GetTitle()</span>
                                            <div class="actions">
                                                <button type="button" onclick="removeMedia('@media.Item1.GetIdDB()', this)">Delete</button>
                                            </div>
                                            <input type="hidden" name="EditablePlaylist.MediaIds" value="@media.Item1.GetIdDB()" />
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </section>

                    <button type="button" class="upload-btn" onclick="addMedia()">Add</button>
                   
                </div>
               
            </div>
            <div class="modal-actions">
                <button type="button" class="cancel-btn" onclick="closePlaylistModal()">Back</button>
                <button type="submit" class="save-btn">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const selectedMedia = new Set();

        document.addEventListener("DOMContentLoaded", function () {
            if ('@Model.ShowPlaylistModal'.toLowerCase() === 'true') openPlaylistModal();
        });

        function openPlaylistModal() {
            document.getElementById("playlistModal").style.display = "flex";
            selectedMedia.clear();

            document.querySelectorAll('input[name="EditablePlaylist.MediaIds"]').forEach(input => {
                selectedMedia.add(input.value);
            });
        }

        function closePlaylistModal() {
            document.getElementById("playlistModal").style.display = "none";

            const form = document.querySelector("#playlistModal form");
            if (form) {
                form.reset();

                const fileInput = form.querySelector('input[type="file"]');
                if (fileInput) {
                    fileInput.value = "";
                }
            }

            const mediaSelect = document.getElementById("mediaSelect");
            if (mediaSelect) {
                mediaSelect.selectedIndex = 0;
            }

            const typeSelect = form.querySelector('select[name="EditableCollection.Type"]');
            if (typeSelect) {
                typeSelect.selectedIndex = 0;
            }

            const validationErrors = form.querySelectorAll(".field-validation-error, .text-danger");
            validationErrors.forEach(el => {
                el.textContent = "";
                el.classList.remove("field-validation-error");
                el.classList.add("field-validation-valid");
            });

            selectedMedia.clear();

            document.getElementById("selectedMediaList").innerHTML = "";
            document.getElementById("hiddenMediaInputs").innerHTML = "";

            const previewContainer = document.getElementById("previewContainer");
            if (previewContainer) {
                previewContainer.innerHTML = '<div id="musicIcon" class="musicIcon justify-content-center"></div>';
            }
        }

        function confirmDelete(id) {
            document.getElementById("deleteItemId").value = id;
            document.getElementById("confirmDeleteModal").style.display = "flex";
        }

        function closeDeleteModal() {
            document.getElementById("confirmDeleteModal").style.display = "none";
        }

        function updateFilePreview() {
            const input = document.querySelector('[name="EditablePlaylist.FileImage"]');
            const container = document.getElementById('previewContainer');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    container.innerHTML = `<img id="previewImage" src="${e.target.result}" style="max-width:150px; border-radius:10px;" />`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function addMedia() {
            const select = document.getElementById("mediaSelect");
            const id = select.value;
            const text = select.options[select.selectedIndex].text;

            if (!id || selectedMedia.has(id)) return;
            selectedMedia.add(id);

            const list = document.getElementById("selectedMediaList");
            const div = document.createElement("div");
            div.className = "media-item-in-collection-form";
            div.innerHTML = `
                        <span>${text}</span>
                        <div class="actions"><button type="button" onclick="removeMedia('${id}', this)">Delete</button></div>
                        <input type="hidden" name="EditablePlaylist.MediaIds" value="${id}" />
                    `;
            list.appendChild(div);
        }

        function removeMedia(id, button) {
            selectedMedia.delete(id);
            button.closest(".media-item-in-collection-form").remove();
        }

        function filterPlaylists() {
            const input = document.getElementById("playlistSearchInput").value.toLowerCase();
            const items = document.querySelectorAll(".media-item");

            items.forEach(item => {
                const title = item.querySelector("span")?.textContent.toLowerCase();
                if (title.includes(input)) {
                    item.style.display = "";
                } else {
                    item.style.display = "none";
                }
            });


           
        }
    </script>
}
