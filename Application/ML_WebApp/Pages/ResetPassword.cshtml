@page
@model ResetPasswordModel

<div class="form-wrapper">
    <div class="login-form-card navbar-dark bg-dark">
        <h2 class="card-header">New Password</h2>

        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Token" />

                <label>New password:</label>
                <input asp-for="NewPassword" type="password" class="field-input-reg-log" />

                <button class="play-button mt-3">Reset password</button>

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-danger mt-3">
                        @Model.Message
                    </div>
                }
            </form>
        </div>
    </div>
</div>
