@page
@model ForgotPasswordModel

<div class="form-wrapper">
    <div class="login-form-card navbar-dark bg-dark">
        <h2 class="card-header">Reset Password</h2>

        <div class="card-body">
            <form method="post">
                <label>Email:</label>
                <input asp-for="Email" class="field-input-reg-log" />

                <button class="play-button mt-3">Send reset link</button>

                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-info mt-3">
                        @Model.Message
                    </div>
                }
            </form>
        </div>
    </div>
</div>
