@page
@model ML_WebApp.Pages.LogOutModel
@{
}
<div class="form-wrapper">
    <div class="login-form-card navbar-dark bg-dark">
        <h2 class="card-header">Login</h2>
        <div class=" card-body">
            <form method="post">
                <div class="centered-container">
                    <p class="align-content-center">Are you sure you want to log out?</p>
                </div>
                <div class="centered-container">

                    <button type="submit" name="action" value="cancel" class="play-button align-content-center">Cancel</button>
                    <button type="submit" name="action" value="logout" class="play-button align-content-center">Log out</button>
                </div>
            </form>   
        </div>
            
    </div>
        
</div>
   
               